
<svg width="1200" height="260" viewBox="0 0 1200 260" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#081527"/>
      <stop offset="55%" stop-color="#0e2540"/>
      <stop offset="100%" stop-color="#123a5e"/>
    </linearGradient>
    <linearGradient id="skyText" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#e0f2fe"/>
      <stop offset="45%" stop-color="#7dd3fc"/>
      <stop offset="100%" stop-color="#38bdf8"/>
    </linearGradient>
    <radialGradient id="orbGrad" cx="35%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#e0f2fe"/>
      <stop offset="45%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#0369a1"/>
    </radialGradient>
    <filter id="clayShadow" x="-60%" y="-60%" width="220%" height="220%">
      <feDropShadow dx="0" dy="8" stdDeviation="9" flood-color="#020c18" flood-opacity="0.55"/>
      <feDropShadow dx="-4" dy="-4" stdDeviation="5" flood-color="#bfe9ff" flood-opacity="0.35"/>
    </filter>
    <filter id="softGlow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="7" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <pattern id="dots" width="26" height="26" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.3" fill="#7dd3fc"/>
    </pattern>
  </defs>

  <rect width="1200" height="260" rx="28" fill="url(#bgGrad)"/>
  <rect width="1200" height="260" rx="28" fill="url(#dots)" opacity="0.14"/>

  <circle cx="115" cy="66" r="34" fill="url(#orbGrad)" filter="url(#clayShadow)">
    <animateTransform attributeName="transform" type="translate" values="0,0; 0,-16; 0,0" dur="4.5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="1086" cy="58" r="24" fill="url(#orbGrad)" filter="url(#clayShadow)" opacity="0.9">
    <animateTransform attributeName="transform" type="translate" values="0,0; 0,13; 0,0" dur="3.6s" repeatCount="indefinite"/>
  </circle>
  <circle cx="1005" cy="196" r="18" fill="url(#orbGrad)" filter="url(#clayShadow)" opacity="0.85">
    <animateTransform attributeName="transform" type="translate" values="0,0; 0,-11; 0,0" dur="5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="148" cy="204" r="14" fill="url(#orbGrad)" filter="url(#clayShadow)" opacity="0.75">
    <animateTransform attributeName="transform" type="translate" values="0,0; 0,11; 0,0" dur="3.1s" repeatCount="indefinite"/>
  </circle>
  <circle cx="60" cy="150" r="9" fill="url(#orbGrad)" filter="url(#clayShadow)" opacity="0.6">
    <animateTransform attributeName="transform" type="translate" values="0,0; 0,-8; 0,0" dur="2.6s" repeatCount="indefinite"/>
  </circle>

  <text x="600" y="128" text-anchor="middle" font-family="'Trebuchet MS', Verdana, sans-serif" font-size="64" font-weight="700" fill="url(#skyText)" filter="url(#softGlow)" letter-spacing="4">MARISON M</text>

  <rect x="315" y="155" width="570" height="46" rx="23" fill="#0d223c" filter="url(#clayShadow)"/>
  <text x="600" y="184" text-anchor="middle" font-family="'Trebuchet MS', Verdana, sans-serif" font-size="17" font-weight="600" fill="#7dd3fc" letter-spacing="1.4">PYTHON DEVELOPER · AI ENGINEER IN PROGRESS</text>

  <text x="600" y="230" text-anchor="middle" font-family="Verdana, sans-serif" font-size="14" fill="#93c5fd" opacity="0.85">Building backend systems and exploring intelligent applications powered by LLMs</text>
</svg>
